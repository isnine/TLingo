#!/bin/bash

set -euo pipefail

# Pre-commit hook to prevent committing generated secrets or leaked credentials.
PATTERNS=(
    'sk-[A-Za-z0-9_-]{20,}'
    'AIza[0-9A-Za-z_-]{35}'
    'gh[pousr]_[A-Za-z0-9]{30,}'
    'AKIA[0-9A-Z]{16}'
    'xox[baprs]-[A-Za-z0-9-]{10,}'
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'api[_-]?key[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{10,}'
    '(client_?secret|secret_?key|hmac_?secret)[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{10,}'
    'password[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{8,}'
    'openai\.azure\.com'
    'REDACTED_AZURE_API_KEY'
    'REDACTED_HMAC_SECRET'
)

EXCLUDE_PATTERNS=(
    '\.md$'
    '\.example$'
    'pre-commit$'
    '\.gitignore$'
)

echo "Running secret detection pre-commit hook..."

FOUND_SECRETS=0

while IFS= read -r FILE; do
    [[ -z "$FILE" ]] && continue

    if [[ "$FILE" == *"AppSecrets.swift" ]]; then
        echo "❌ Refusing to commit generated secret file: $FILE"
        FOUND_SECRETS=1
        continue
    fi

    SKIP=0
    for EXCLUDE in "${EXCLUDE_PATTERNS[@]}"; do
        if [[ "$FILE" =~ $EXCLUDE ]]; then
            SKIP=1
            break
        fi
    done
    if [[ $SKIP -eq 1 ]]; then
        continue
    fi

    ADDED_LINES=$(git diff --cached -U0 -- "$FILE" | grep '^+[^+]' | sed 's/^+//' || true)
    [[ -z "$ADDED_LINES" ]] && continue

    for PATTERN in "${PATTERNS[@]}"; do
        MATCH_LINE=$(printf '%s\n' "$ADDED_LINES" | grep -E "$PATTERN" | head -1 || true)
        [[ -z "$MATCH_LINE" ]] && continue
        if [[ "$MATCH_LINE" == *"YOUR_"* ]] || [[ "$MATCH_LINE" == *"EXAMPLE"* ]] || [[ "$MATCH_LINE" == *"PLACEHOLDER"* ]] || [[ "$MATCH_LINE" == *"example.invalid"* ]] || [[ "$MATCH_LINE" == *"notion.site"* ]] || [[ "$MATCH_LINE" == *"notion.so"* ]]; then
            continue
        fi

        echo "❌ Potential secret found in staged diff of: $FILE"
        echo "   Pattern: $PATTERN"
        FOUND_SECRETS=1
    done
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ $FOUND_SECRETS -eq 1 ]]; then
    echo ""
    echo "🚫 Commit blocked: Potential secrets detected!"
    echo ""
    echo "If this is a false positive, you can:"
    echo "  1. Add the file pattern to EXCLUDE_PATTERNS in .githooks/pre-commit"
    echo "  2. Use 'git commit --no-verify' to bypass (use with caution!)"
    echo ""
    exit 1
fi

echo "✅ No secrets detected"
exit 0
