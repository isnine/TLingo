#include "Base.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) TLINGO_HELPER
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_VERSION = 5.0
SUPPORTED_PLATFORMS = macosx
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
PRODUCT_BUNDLE_IDENTIFIER = com.zanderwang.TLingoHelper
PRODUCT_NAME = TLingoHelper
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = TLingoHelper/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = TLingoHelper
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_LSUIElement = YES
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = TLingoHelper/TLingoHelper.entitlements
DEVELOPMENT_TEAM = JW2LR94V6G
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
PROVISIONING_PROFILE_SPECIFIER =
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
