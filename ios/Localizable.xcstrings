        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace para iniciar sesión ha caducado. Toca \"Intentar de nuevo\" para empezar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien de connexion a expiré. Touchez \"Réessayer\" pour recommencer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan masuk telah kedaluwarsa. Ketuk 'Coba Lagi' untuk memulai ulang."
