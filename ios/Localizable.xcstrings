    "Sign-in link expired. Tap Try Again to start over." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية رابط تسجيل الدخول. اضغط على \"حاول مرة أخرى\" للبدء من جديد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilmeldingslinket er udløbet. Tryk på 'Prøv igen' for at starte forfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anmeldelink ist abgelaufen. Tippe auf 'Erneut versuchen', um neu zu beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in link expired. Tap Try Again to start over."
          }
