    "Speech recognition ended unexpectedly. End Realtime and start realtime again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى التعرف على الكلام بشكل غير متوقع. أوقف ميزة الوقت الحقيقي ثم أعد تشغيلها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talegenkendelse sluttede uventet. Afslut realtidsfunktionen og start den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung wurde unerwartet beendet. Beende die Echtzeitfunktion und starte sie erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition ended unexpectedly. End Realtime and start realtime again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz terminó inesperadamente. Finaliza la función de tiempo real y vuelve a iniciarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale s'est arrêtée de façon inattendue. Arrêtez le mode temps réel et redémarrez-le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenalan suara berakhir secara tak terduga. Hentikan mode waktu nyata dan mulai kembali."
          }
        },
        "it" : {
          "stringUnit" : {
