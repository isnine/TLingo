    "Describe the action you want, the more detail the better." : {
      "comment" : "Voice recording idle guidance",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صف الإجراء الذي تريده، كلما زادت التفاصيل كان أفضل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv den handling, du ønsker, jo flere detaljer, jo bedre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreiben Sie die Aktion, die Sie möchten, je mehr Details, desto besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the action you want, the more detail the better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe la acción que deseas, cuanta más detalle, mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez l'action que vous souhaitez, plus il y a de détails, mieux c'est."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deskripsikan tindakan yang Anda inginkan, semakin banyak detail semakin baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi l'azione che desideri, più dettagli ci sono, meglio è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "望むアクションを詳しく説明してください。詳細が多いほど良いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 작업을 설명하세요. 세부 사항이 많을수록 좋습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terangkan tindakan yang anda mahukan, semakin banyak butiran, semakin baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv handlingen du ønsker, jo flere detaljer desto bedre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf de actie die je wilt, hoe meer details, hoe beter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz żądaną akcję, im więcej szczegółów, tym lepiej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva a ação que você deseja, quanto mais detalhes melhor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv åtgärden du önskar, ju fler detaljer desto bättre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz eylemi tanımlayın, ne kadar fazla detay varsa o kadar iyi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述您想要的操作，细节越多越好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述您想要的操作，細節越多越好。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述您想要的操作，細節越多越好。"
          }
        }
      }
    },
