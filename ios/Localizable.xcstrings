    "Memory pressure is too high. Close memory-intensive apps, remove a view, or choose a lighter model." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغط الذاكرة مرتفع جدًا. أغلق التطبيقات المجهدة للذاكرة، أزل عرضًا، أو اختر نموذجًا أخف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory-presset er for højt. Luk hukommelsesintensive apps, fjern en visning, eller vælg en lettere model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicherbedarf ist zu hoch. Schließe speicherintensive Apps, entferne eine Ansicht oder wähle ein leichteres Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory pressure is too high. Close memory-intensive apps, remove a view, or choose a lighter model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presión de memoria es demasiado alta. Cierra aplicaciones que consumen mucha memoria, elimina una vista o elige un modelo más ligero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pression mémoire est trop élevée. Fermez les apps gourmandes en mémoire, supprimez une vue ou choisissez un modèle plus léger."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekanan memori terlalu tinggi. Tutup aplikasi yang banyak menggunakan memori, hapus sebuah tampilan, atau pilih model yang lebih ringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pressione della memoria è troppo alta. Chiudi le app che occupano molta memoria, rimuovi una vista o scegli un modello più leggero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリの使用率が高すぎます。メモリを大量に消費するアプリを閉じる、ビューを削除する、または軽いモデルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 압력이 너무 높습니다. 메모리를 많이 사용하는 앱을 종료하거나, 뷰를 제거하거나, 더 가벼운 모델을 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekanan memori terlalu tinggi. Tutup aplikasi yang menggunakan banyak memori, keluarkan paparan, atau pilih model yang lebih ringan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minnebelastningen er for høy. Lukk minnekrevende apper, fjern en visning eller velg en lettere modell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geheugendruk is te hoog. Sluit geheugenintensieve apps, verwijder een weergave of kies een lichter model."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie pamięci jest zbyt wysokie. Zamknij aplikacje intensywnie korzystające z pamięci, usuń widok lub wybierz lżejszy model."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pressão de memória está muito alta. Feche apps que consomem muita memória, remova uma visualização ou escolha um modelo mais leve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minnesbelastningen är för hög. Stäng minnesintensiva appar, ta bort en vy eller välj en lättare modell."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bellek basıncı çok yüksek. Bellek yoğun uygulamaları kapatın, bir görüntüyü kaldırın veya daha hafif bir model seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存压力过高。关闭占用大量内存的应用、移除一个视图或选择更轻量的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶體壓力過高。關閉佔用大量記憶體的應用程式、移除一個檢視或選擇較輕量的模型。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶體壓力過高。關閉耗用大量記憶體的應用程式、移除一個檢視或選擇較輕量的模型。"
          }
        }
      }
    },
