        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate belum mengunduh pasangan bahasa ini. Gunakan Apple Translate di aplikasi utama sekali, lalu mulai kembali Audio iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate non ha scaricato questa coppia di lingue. Usa Apple Translate nell'app principale una volta, quindi avvia nuovamente l'audio dell'iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate はこの言語ペアをダウンロードしていません。メインアプリで一度 Apple Translate を使ってから、もう一度 iPhone オーディオを開始してください。"
          }
