    "Please make this message clearer and more natural." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرجاء جعل هذه الرسالة أوضح وأكثر طبيعية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør venligst denne besked klarere og mere naturlig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte machen Sie diese Nachricht klarer und natürlicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please make this message clearer and more natural."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, haz este mensaje más claro y natural."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez rendre ce message plus clair et plus naturel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolong buat pesan ini lebih jelas dan terdengar lebih alami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per favore rendi questo messaggio più chiaro e naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメッセージをもっと明確で自然な表現にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 메시지를 더 명확하고 자연스럽게 만들어 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila jadikan mesej ini lebih jelas dan lebih semula jadi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vennligst gjør denne meldingen klarere og mer naturlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak dit bericht alstublieft duidelijker en natuurlijker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proszę sprawić, by ta wiadomość była jaśniejsza i brzmiała bardziej naturalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, torne esta mensagem mais clara e natural."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör gärna detta meddelande tydligare och mer naturligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen bu mesajı daha açık ve doğal hale getirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使此消息更清晰、更自然。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使此訊息更清楚、更自然。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使此訊息更清楚、更自然。"
          }
        }
      }
    },
    "Please try translating in the main window and wait for the system prompt to download the target language." : {
      "comment" : "Shown when Apple Translate cannot translate because the language pack is not installed on device",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى المحاولة في النافذة الرئيسية وانتظار ظهور موجه النظام لتنزيل اللغة المستهدفة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv at oversætte i hovedvinduet, og vent på, at systemets prompt om at downloade målsproget vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte versuche die Übersetzung im Hauptfenster und warte, bis die Systemaufforderung zum Herunterladen der Zielsprache erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please try translating in the main window and wait for the system prompt to download the target language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta traducir en la ventana principal y espera a que aparezca el aviso del sistema para descargar el idioma de destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de traduire dans la fenêtre principale et attendez l'invite système pour télécharger la langue cible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba terjemahkan di jendela utama dan tunggu hingga muncul permintaan sistem untuk mengunduh bahasa target."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a tradurre nella finestra principale e attendi la richiesta di sistema per scaricare la lingua di destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインウィンドウで翻訳を試し、ターゲット言語をダウンロードするシステムのダイアログが表示されるまでお待ちください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인 창에서 번역을 시도하고 대상 언어를 다운로드하라는 시스템 알림이 나타날 때까지 기다려 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila cuba menterjemah di tetingkap utama dan tunggu arahan sistem untuk memuat turun bahasa sasaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv å oversette i hovedvinduet, og vent til systemvarselet for å laste ned målspråket vises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer te vertalen in het hoofdvenster en wacht tot de systeemvraag verschijnt om de doeltaal te downloaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj przetłumaczyć w głównym oknie i poczekaj na komunikat systemowy, aby pobrać język docelowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente traduzir na janela principal e aguarde o aviso do sistema para baixar o idioma de destino."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök att översätta i huvudfönstret och vänta på systemets uppmaning att ladda ner målspråket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen ana pencerede çevirmeyi deneyin ve hedef dili indirmek için sistem uyarısının çıkmasını bekleyin."
