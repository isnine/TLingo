    "Activation cancelled (%@). Tap Try Again to retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إلغاء التنشيط (%@). اضغط على 'حاول مرة أخرى' لإعادة المحاولة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering annulleret (%@). Tryk på 'Prøv igen' for at forsøge igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivierung abgebrochen (%@). Tippen Sie auf 'Erneut versuchen', um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activation cancelled (%@). Tap Try Again to retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activación cancelada (%@). Toque 'Intentar de nuevo' para reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activation annulée (%@). Appuyez sur 'Réessayer' pour réessayer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivasi dibatalkan (%@). Ketuk 'Coba Lagi' untuk mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivazione annullata (%@). Tocca 'Riprova' per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効化がキャンセルされました (%@)。「再試行」をタップしてやり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화가 취소되었습니다 (%@). '다시 시도'를 눌러 재시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaktifan dibatalkan (%@). Ketik 'Cuba Lagi' untuk mencuba semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering avbrutt (%@). Trykk 'Prøv igjen' for å prøve på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activering geannuleerd (%@). Tik op 'Opnieuw proberen' om het opnieuw te proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywacja anulowana (%@). Stuknij 'Spróbuj ponownie', aby ponowić próbę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativação cancelada (%@). Toque em 'Tentar novamente' para tentar novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering avbruten (%@). Tryck på 'Försök igen' för att försöka igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirme iptal edildi (%@). 'Tekrar Dene'ye dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "激活已取消 (%@)。点按“重试”以重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用已取消 (%@)。點按「再試一次」以重試。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動已取消 (%@)。點按「再試一次」以重試。"
          }
        }
      }
    },
    "Activation completed, but this account is not Pro. Contact support if you already paid." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التفعيل، ولكن هذا الحساب ليس Pro. اتصل بالدعم إذا كنت قد دفعت بالفعل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering gennemført, men denne konto er ikke Pro. Kontakt support, hvis du allerede har betalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivierung abgeschlossen, aber dieses Konto ist nicht Pro. Kontaktiere den Support, wenn du bereits bezahlt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activation completed, but this account is not Pro. Contact support if you already paid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activación completada, pero esta cuenta no es Pro. Contacta con el soporte si ya pagaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activation terminée, mais ce compte n'est pas Pro. Contactez le support si vous avez déjà payé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivasi selesai, tetapi akun ini bukan Pro. Hubungi dukungan jika Anda sudah membayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivazione completata, ma questo account non è Pro. Contatta il supporto se hai già pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティベーションは完了しましたが、このアカウントはProではありません。支払い済みの場合はサポートにお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화가 완료되었지만 이 계정은 Pro가 아닙니다. 이미 결제하셨다면 고객지원에 문의하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaktifan selesai, tetapi akaun ini bukan Pro. Hubungi sokongan jika anda telah membayar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering fullført, men denne kontoen er ikke Pro. Kontakt support hvis du allerede har betalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activering voltooid, maar dit account is geen Pro. Neem contact op met support als je al betaald hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywacja zakończona, ale to konto nie ma statusu Pro. Skontaktuj się z pomocą techniczną, jeśli już zapłaciłeś/aś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativação concluída, mas esta conta não é Pro. Contate o suporte se você já pagou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering slutförd, men det här kontot är inte Pro. Kontakta support om du redan har betalat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirme tamamlandı, ancak bu hesap Pro değil. Zaten ödeme yaptıysanız destek ile iletişime geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "激活已完成，但此帐户不是 Pro。若您已付款，请联系支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用已完成，但此帳戶並非 Pro。如已付款，請聯絡支援。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用已完成，但此帳戶並非 Pro。如已付款，請聯絡支援。"
          }
        }
      }
