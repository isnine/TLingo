    "This local file is also used for email feedback." : {

    },
    "This Mac cannot run this many different local models. Remove a view or reuse the same recognition model." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الـMac لا يمكنه تشغيل هذا العدد الكبير من النماذج المحلية المختلفة. أزل عرضًا أو أعد استخدام نفس نموذج التعرف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac kan ikke køre så mange forskellige lokale modeller. Fjern en visning eller genbrug samme genkendelsesmodel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann nicht so viele verschiedene lokale Modelle ausführen. Entferne eine Ansicht oder verwende dasselbe Erkennungsmodell erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac cannot run this many different local models. Remove a view or reuse the same recognition model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no puede ejecutar tantos modelos locales diferentes. Elimina una vista o reutiliza el mismo modelo de reconocimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne peut pas exécuter autant de modèles locaux différents. Supprimez une vue ou réutilisez le même modèle de reconnaissance."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini tidak dapat menjalankan begitu banyak model lokal berbeda. Hapus sebuah tampilan atau gunakan kembali model pengenalan yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac non può eseguire così tanti modelli locali diversi. Rimuovi una vista o riutilizza lo stesso modello di riconoscimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac ではこれほど多くの異なるローカルモデルを動かすことはできません。ビューを削除するか、同じ認識モデルを再利用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서는 이렇게 많은 서로 다른 로컬 모델을 실행할 수 없습니다. 뷰를 제거하거나 동일한 인식 모델을 재사용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini tidak boleh menjalankan sebanyak ini model tempatan berbeza. Keluarkan satu paparan atau guna semula model pengecaman yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac-en kan ikke kjøre så mange ulike lokale modeller. Fjern en visning eller gjenbruk samme gjenkjenningsmodell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac kan niet zoveel verschillende lokale modellen draaien. Verwijder een weergave of hergebruik hetzelfde herkenningsmodel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Mac nie może uruchomić tylu różnych lokalnych modeli. Usuń widok lub ponownie użyj tego samego modelu rozpoznawania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
