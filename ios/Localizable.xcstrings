    "Remind me before the trial ends, so I can cancel in time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذكرني قبل انتهاء الفترة التجريبية حتى أتمكن من الإلغاء في الوقت المناسب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mind mig før prøveperioden slutter, så jeg kan annullere i tide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnere mich, bevor die Testphase endet, damit ich rechtzeitig kündigen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remind me before the trial ends, so I can cancel in time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuérdame antes de que termine la prueba, para que pueda cancelar a tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappelle-moi avant la fin de l'essai, pour que je puisse annuler à temps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingatkan saya sebelum masa percobaan berakhir, agar saya bisa membatalkan tepat waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricordami prima che finisca il periodo di prova, così posso annullare in tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用期間が終了する前に通知して、期限内にキャンセルできるようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험 기간이 끝나기 전에 알려줘서 제때 취소할 수 있게 해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingatkan saya sebelum tempoh percubaan berakhir, supaya saya dapat membatalkan tepat pada masanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi meg en påminnelse før prøveperioden avsluttes, slik at jeg kan avbestille i tide."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinner me voordat de proefperiode eindigt, zodat ik op tijd kan annuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnij mi przed końcem okresu próbnego, żebym zdążył anulować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembre-me antes do fim do período de teste, para que eu possa cancelar a tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminn mig innan provperioden slutar, så att jag kan avbryta i tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme bitmeden önce hatırlat, böylece zamanında iptal edebilirim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在试用结束前提醒我，以便我能及时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在試用期結束前提醒我，讓我能及時取消。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在試用結束前提醒我，以便我能及時取消。"
          }
        }
      }
