    "Lifetime is a one-time purchase. Subscriptions restore from the App Store when available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدى الحياة هو شراء لمرة واحدة. يتم استعادة الاشتراكات من App Store عند توفرها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livstid er et engangskøb. Abonnementer gendannes fra App Store, når de er tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebenslang ist ein Einmalkauf. Abonnements werden aus dem App Store wiederhergestellt, wenn verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lifetime is a one-time purchase. Subscriptions restore from the App Store when available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De por vida es una compra única. Las suscripciones se restauran desde el App Store cuando estén disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À vie est un achat unique. Les abonnements se restaurent depuis l'App Store lorsqu'ils sont disponibles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seumur hidup adalah pembelian satu kali. Langganan dipulihkan dari App Store bila tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vita è un acquisto una tantum. Gli abbonamenti vengono ripristinati dall'App Store quando disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「生涯」は一度きりの購入です。サブスクリプションは利用可能な場合、App Storeから復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평생은 일회성 구매입니다. 구독은 사용 가능한 경우 App Store에서 복원됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seumur hidup adalah pembelian sekali sahaja. Langganan akan dipulihkan dari App Store apabila tersedia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livstid er et engangskjøp. Abonnementer gjenskapes fra App Store når tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levenslang is een eenmalige aankoop. Abonnementen worden vanuit de App Store hersteld wanneer beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dożywotnia to jednorazowy zakup. Subskrypcje można przywrócić z App Store, gdy są dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitalício é uma compra única. Assinaturas são restauradas pela App Store quando disponíveis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livstid är ett engångsköp. Prenumerationer återställs från App Store när de finns tillgängliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ömür boyu tek seferlik bir satın almadır. Abonelikler, mevcut olduğunda App Store'dan geri yüklenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终身是一次性购买。订阅在可用时可从 App Store 恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終身是一次性購買。訂閱可在可用時從 App Store 還原。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終身為一次性購買。訂閱可於可用時從 App Store 恢復。"
          }
        }
      }
    },
