    "Share quick feedback so the translation experience keeps improving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك ملاحظة سريعة حتى تستمر تجربة الترجمة في التحسن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del hurtig feedback, så oversættelsesoplevelsen fortsat forbedres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile kurzes Feedback, damit die Übersetzungserfahrung sich stetig verbessert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share quick feedback so the translation experience keeps improving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte una opinión rápida para que la experiencia de traducción siga mejorando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez un retour rapide pour que l'expérience de traduction s'améliore en continu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan umpan balik singkat agar pengalaman terjemahan terus membaik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi un feedback veloce in modo che l'esperienza di traduzione continui a migliorare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳体験をより良くするために、簡単なフィードバックを共有してください。"
