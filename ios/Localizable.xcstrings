    "Wait for memory pressure to decrease before adding another realtime lane." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظر حتى ينخفض ضغط الذاكرة قبل إضافة مسار وقت حقيقي آخر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent på, at hukommelsesbelastningen falder, før du tilføjer endnu en realtime-kanal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten Sie, bis der Speicherbedarf sinkt, bevor Sie eine weitere Echtzeit-Spur hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for memory pressure to decrease before adding another realtime lane."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere a que la presión de memoria disminuya antes de añadir otro canal en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez que la pression mémoire diminue avant d'ajouter une autre voie en temps réel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunggu sampai tekanan memori berkurang sebelum menambahkan jalur real-time lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendere che la pressione della memoria diminuisca prima di aggiungere un altro canale in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のリアルタイムレーンを追加する前に、メモリ負荷が低下するのを待ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 실시간 채널을 추가하기 전에 메모리 압박이 줄어들 때까지 기다리십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunggu sehingga tekanan memori berkurang sebelum menambah satu lagi laluan masa nyata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent til minnebelastningen avtar før du legger til en ny sanntidskanal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht tot de geheugenbelasting afneemt voordat je een extra realtime-kanaal toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj, aż obciążenie pamięci spadnie, zanim dodasz kolejny kanał w czasie rzeczywistym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde que a pressão de memória diminua antes de adicionar outro canal em tempo real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänta tills minnesbelastningen minskar innan du lägger till en annan realtidskanal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir gerçek zamanlı hat eklemeden önce bellek kullanımının azalmasını bekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在添加另一个实时通道之前，请等待内存压力降低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新增另一個實時通道之前，請等待記憶體壓力下降。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新增另一個實時通道之前，請等候記憶體壓力下降。"
          }
        }
      }
    },
    "Wait for the current startup attempt to finish before trying again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظر انتهاء محاولة بدء التشغيل الحالية قبل المحاولة مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent på, at det nuværende opstartsforsøg afsluttes, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten Sie, bis der aktuelle Startversuch abgeschlossen ist, bevor Sie es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wait for the current startup attempt to finish before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere a que el intento de inicio actual termine antes de intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin de la tentative de démarrage en cours avant de réessayer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunggu sampai upaya startup saat ini selesai sebelum mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendere il completamento dell'attuale tentativo di avvio prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の起動の試行が完了するまで待ってから、再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 시작 시도가 완료될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunggu sehingga cubaan permulaan semasa selesai sebelum mencuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent til det nåværende oppstartsforsøket er ferdig før du prøver igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht tot de huidige opstartpoging is voltooid voordat je het opnieuw probeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj, aż bieżąca próba uruchomienia zakończy się, zanim spróbujesz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a tentativa de inicialização atual terminar antes de tentar novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänta tills det aktuella startförsöket slutförts innan du försöker igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
