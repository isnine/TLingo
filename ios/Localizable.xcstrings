    "Order completed results by completion time, or use Premium → Free AI → Apple AI → Translation Services, preserving each group’s model list order." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رتّب النتائج المكتملة حسب وقت اكتمالها، أو استخدم الترتيب: المميز ← الذكاء الاصطناعي المجاني ← Apple AI ← خدمات الترجمة، مع الحفاظ على ترتيب قائمة النماذج داخل كل مجموعة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortér færdige resultater efter færdiggørelsestidspunkt, eller brug Premium → Gratis AI → Apple AI → Oversættelsestjenester, og bevar modellistens rækkefølge i hver gruppe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortiere fertige Ergebnisse nach Abschlusszeit oder verwende Premium → Kostenlose KI → Apple AI → Übersetzungsdienste. Die Reihenfolge der Modellliste innerhalb jeder Gruppe bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Order completed results by completion time, or use Premium → Free AI → Apple AI → Translation Services, preserving each group’s model list order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordena los resultados completos por hora de finalización o usa Premium → IA gratuita → Apple AI → Servicios de traducción, manteniendo el orden de la lista de modelos de cada grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triez les résultats terminés par heure de fin, ou utilisez Premium → IA gratuite → Apple AI → Services de traduction, en conservant l’ordre de la liste des modèles de chaque groupe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urutkan hasil yang sudah selesai berdasarkan waktu penyelesaian, atau gunakan Premium → AI Gratis → Apple AI → Layanan Terjemahan, dengan mempertahankan urutan daftar model di setiap grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordina i risultati completati per ora di completamento oppure usa Premium → IA gratuita → Apple AI → Servizi di traduzione, mantenendo l’ordine dell’elenco dei modelli di ciascun gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成した結果を完了時刻順に並べるか、プレミアム → 無料AI → Apple AI → 翻訳サービスの順に並べ、各グループ内ではモデル一覧の順序を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료된 결과를 완료 시간순으로 정렬하거나 프리미엄 → 무료 AI → Apple AI → 번역 서비스 순으로 정렬하며, 각 그룹 내 모델 목록 순서를 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Susun hasil yang telah selesai mengikut masa selesai, atau gunakan Premium → AI Percuma → Apple AI → Perkhidmatan Terjemahan, dengan mengekalkan susunan senarai model dalam setiap kumpulan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorter ferdige resultater etter fullføringstidspunkt, eller bruk Premium → Gratis KI → Apple AI → Oversettelsestjenester, og behold modellistens rekkefølge i hver gruppe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteer voltooide resultaten op voltooiingstijd, of gebruik Premium → Gratis AI → Apple AI → Vertaaldiensten, met behoud van de volgorde van de modellijst binnen elke groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortuj ukończone wyniki według czasu ukończenia lub użyj kolejności Premium → Bezpłatna AI → Apple AI → Usługi tłumaczeniowe, zachowując kolejność listy modeli w każdej grupie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordene os resultados concluídos pelo horário de conclusão ou use Premium → IA gratuita → Apple AI → Serviços de tradução, preservando a ordem da lista de modelos de cada grupo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortera färdiga resultat efter slutförandetid, eller använd Premium → Gratis AI → Apple AI → Översättningstjänster, och behåll modellistans ordning inom varje grupp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamlanan sonuçları tamamlanma zamanına göre sıralayın veya her grubun model listesi sırasını koruyarak Premium → Ücretsiz Yapay Zekâ → Apple AI → Çeviri Hizmetleri sırasını kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按完整结果的返回时间排序，或按会员、免费 AI、Apple AI、翻译服务各组的模型列表顺序排序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依完整結果的回傳時間排序，或依會員、免費 AI、Apple AI、翻譯服務各組的模型清單順序排序。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按完整結果的返回時間排序，或按會員、免費 AI、Apple AI、翻譯服務各組的模型列表順序排序。"
          }
        }
      }
    },
