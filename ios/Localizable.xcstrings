    "Cancel at least 24 hours before the end of the current period to avoid renewal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغِ قبل 24 ساعة على الأقل من نهاية الفترة الحالية لتجنب التجديد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuller senest 24 timer før slutningen af den nuværende periode for at undgå fornyelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kündigen Sie mindestens 24 Stunden vor Ende des aktuellen Zeitraums, um eine Verlängerung zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel at least 24 hours before the end of the current period to avoid renewal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela al menos 24 horas antes del final del periodo actual para evitar la renovación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulez au moins 24 heures avant la fin de la période en cours pour éviter le renouvellement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan setidaknya 24 jam sebelum akhir periode saat ini untuk menghindari perpanjangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla almeno 24 ore prima della fine del periodo corrente per evitare il rinnovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新を避けるために、現在の期間の終了の少なくとも24時間前までにキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갱신을 방지하려면 현재 기간이 끝나기 최소 24시간 전에 취소하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan sekurang-kurangnya 24 jam sebelum akhir tempoh semasa untuk mengelakkan pembaharuan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt senest 24 timer før slutten av den gjeldende perioden for å unngå fornyelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuleer minstens 24 uur voor het einde van de huidige periode om verlenging te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuluj co najmniej 24 godziny przed końcem bieżącego okresu, aby uniknąć odnowienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele pelo menos 24 horas antes do término do período atual para evitar a renovação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbryt minst 24 timmar innan den nuvarande perioden avslutas för att undvika förnyelse."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilemeyi önlemek için mevcut dönemin bitişinden en az 24 saat önce iptal edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为避免续订，请在当前周期结束前至少24小时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要避免續訂，請在目前期間結束前至少24小時取消。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為避免續訂，請在目前週期結束前至少24小時取消。"
          }
        }
      }
    },
