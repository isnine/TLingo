          "stringUnit" : {
            "state" : "translated",
            "value" : "即時支援最多三條通道。"
          }
        }
      }
    },
    "Realtime supports up to three views. Remove an extra view before starting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime يدعم حتى ثلاث عروض. قم بإزالة العرض الإضافي قبل البدء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime understøtter op til tre visninger. Fjern en ekstra visning, før du starter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime unterstützt bis zu drei Ansichten. Entferne eine zusätzliche Ansicht, bevor du startest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime supports up to three views. Remove an extra view before starting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime admite hasta tres vistas. Elimina una vista adicional antes de comenzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime prend en charge jusqu'à trois vues. Supprimez une vue supplémentaire avant de commencer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime mendukung hingga tiga tampilan. Hapus tampilan ekstra sebelum memulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime supporta fino a tre viste. Rimuovi una vista in eccesso prima di avviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime は最大で3つのビューに対応しています。開始する前に余分なビューを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime는 최대 세 개의 뷰를 지원합니다. 시작하기 전에 추가 뷰를 제거하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime menyokong sehingga tiga paparan. Buang paparan tambahan sebelum memulakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime støtter opptil tre visninger. Fjern en ekstra visning før du starter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime ondersteunt tot drie weergaven. Verwijder een extra weergave voordat je begint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime obsługuje maksymalnie trzy widoki. Usuń dodatkowy widok przed rozpoczęciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime suporta até três visualizações. Remova uma visualização extra antes de iniciar."
          }
