    "Follow conversations, meetings, and videos with realtime captions and translation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع المحادثات والاجتماعات ومقاطع الفيديو مع نصوص وترجمة في الوقت الفعلي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg samtaler, møder og videoer med realtidsundertekster og oversættelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge Gespräche, Besprechungen und Videos mit Echtzeit-Untertiteln und Übersetzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow conversations, meetings, and videos with realtime captions and translation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue conversaciones, reuniones y vídeos con subtítulos y traducción en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les conversations, réunions et vidéos avec des sous-titres et une traduction en temps réel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti percakapan, rapat, dan video dengan teks dan terjemahan waktu nyata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui conversazioni, riunioni e video con sottotitoli e traduzione in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話、会議、ビデオをリアルタイムの字幕と翻訳で追跡できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 자막과 번역으로 대화, 회의 및 동영상을 따라가세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti perbualan, mesyuarat, dan video dengan sari kata dan terjemahan masa nyata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg samtaler, møter og videoer med sanntidsundertekster og oversettelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg gesprekken, vergaderingen en video's met realtime ondertiteling en vertaling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź rozmowy, spotkania i filmy dzięki napisom i tłumaczeniu w czasie rzeczywistym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe conversas, reuniões e vídeos com legendas e tradução em tempo real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ konversationer, möten och videor med realtidsundertexter och översättning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmaları, toplantıları ve videoları gerçek zamanlı altyazı ve çeviri ile takip edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
