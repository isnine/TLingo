    "Create a more accurate transcript with speaker separation. Your realtime draft stays available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ نسخة مكتوبة أكثر دقة بفصل المتحدثين. سيظل مسودتك الفورية متاحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret et mere nøjagtigt transkript med adskillelse af talere. Dit realtidsudkast forbliver tilgængeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein genaueres Transkript mit Sprechertrennung. Dein Echtzeitentwurf bleibt verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a more accurate transcript with speaker separation. Your realtime draft stays available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una transcripción más precisa separando a los hablantes. Tu borrador en tiempo real seguirá disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une transcription plus précise en séparant les intervenants. Votre brouillon en temps réel reste disponible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat transkrip yang lebih akurat dengan pemisahan pembicara. Draf waktu nyata Anda tetap tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una trascrizione più precisa separando i parlanti. La tua bozza in tempo reale rimane disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話者分離により、より正確な文字起こしを作成します。リアルタイムの下書きはそのまま利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화자 구분으로 더 정확한 기록을 만드세요. 실시간 초안은 계속 이용 가능합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cipta transkrip yang lebih tepat dengan pemisahan penceramah. Draf masa nyata anda kekal tersedia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag et mer nøyaktig transkript ved å skille mellom talere. Din sanntidsutkast forblir tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een nauwkeuriger transcript met spreker-scheiding. Je realtime concept blijft beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz dokładniejszy zapis z rozdzieleniem mówców. Twój szkic w czasie rzeczywistym pozostanie dostępny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma transcrição mais precisa com separação de falantes. Seu rascunho em tempo real continua disponível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa en mer exakt transkription genom att separera talare. Ditt realtidsutkast förblir tillgängligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmacı ayrımıyla daha doğru bir transkript oluşturun. Gerçek zamanlı taslağınız kullanılabilir kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过区分发言者创建更准确的转录。您的实时草稿仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
