        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del rask tilbakemelding slik at oversettelsesopplevelsen stadig blir bedre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
