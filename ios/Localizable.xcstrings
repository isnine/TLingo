    "You can now translate selected text from supported apps with TLingo. Want to try more powerful models?" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك الآن ترجمة النص المحدد من التطبيقات المدعومة باستخدام TLingo. هل تريد تجربة نماذج أقوى؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan nu oversætte markeret tekst fra understøttede apps med TLingo. Vil du prøve mere kraftfulde modeller?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jetzt ausgewählten Text aus unterstützten Apps mit TLingo übersetzen. Möchtest du leistungsstärkere Modelle ausprobieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can now translate selected text from supported apps with TLingo. Want to try more powerful models?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora puedes traducir texto seleccionado de aplicaciones compatibles con TLingo. ¿Quieres probar modelos más potentes?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez désormais traduire le texte sélectionné depuis les apps prises en charge avec TLingo. Vous voulez essayer des modèles plus puissants ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sekarang dapat menerjemahkan teks yang dipilih dari aplikasi yang didukung dengan TLingo. Ingin mencoba model yang lebih canggih?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora puoi tradurre il testo selezionato dalle app supportate con TLingo. Vuoi provare modelli più potenti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応しているアプリで選択したテキストをTLingoで翻訳できるようになりました。より強力なモデルを試しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 지원되는 앱에서 선택한 텍스트를 TLingo로 번역할 수 있습니다. 더 강력한 모델을 사용해 볼까요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda kini boleh menterjemah teks yang dipilih dari aplikasi yang disokong dengan TLingo. Mahu cuba model yang lebih berkuasa?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan nå oversette markert tekst fra støttede apper med TLingo. Vil du prøve kraftigere modeller?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt nu geselecteerde tekst uit ondersteunde apps vertalen met TLingo. Wil je krachtigere modellen proberen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz możesz tłumaczyć zaznaczony tekst w obsługiwanych aplikacjach za pomocą TLingo. Chcesz wypróbować bardziej zaawansowane modele?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora você pode traduzir o texto selecionado de apps compatíveis com o TLingo. Quer experimentar modelos mais poderosos?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan nu översätta markerad text från stödda appar med TLingo. Vill du prova kraftfullare modeller?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık desteklenen uygulamalarda seçilen metni TLingo ile çevirebilirsiniz. Daha güçlü modelleri denemek ister misiniz?"
          }
        },
        "zh-Hans" : {
