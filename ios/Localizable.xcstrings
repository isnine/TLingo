    "Pro features will be locked until you activate again. Your subscription on the web is unaffected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُقفل ميزات Pro حتى تقوم بالتفعيل مرة أخرى. اشتراكك على الويب غير متأثر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-funktioner vil blive låst, indtil du aktiverer igen. Dit abonnement på nettet påvirkes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pro-Funktionen werden gesperrt, bis Sie sie erneut aktivieren. Ihr Abonnement im Web bleibt davon unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro features will be locked until you activate again. Your subscription on the web is unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones Pro estarán bloqueadas hasta que vuelvas a activarlas. Tu suscripción en la web no se verá afectada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctionnalités Pro seront verrouillées jusqu'à ce que vous réactiviez. Votre abonnement sur le web n'est pas affecté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitur Pro akan dikunci sampai Anda mengaktifkannya lagi. Langganan Anda di web tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le funzionalità Pro saranno bloccate finché non le riattivi. Il tuo abbonamento sul web non ne risentirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro機能は再度有効化するまでロックされます。Web上の購読は影響を受けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 기능은 다시 활성화할 때까지 잠겨 있습니다. 웹에서의 구독은 영향을 받지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciri Pro akan dikunci sehingga anda mengaktifkannya semula. Langganan anda di laman web tidak terjejas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-funksjoner vil være låst til du aktiverer igjen. Abonnementet ditt på nettet påvirkes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-functies worden vergrendeld totdat je ze opnieuw activeert. Je abonnement op het web wordt hierdoor niet beïnvloed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcje Pro będą zablokowane, dopóki ponownie ich nie aktywujesz. Twoja subskrypcja w serwisie internetowym pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os recursos Pro serão bloqueados até que você os ative novamente. Sua assinatura na web não será afetada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-funktioner kommer att låsas tills du aktiverar igen. Din prenumeration på webben påverkas inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro özellikleri yeniden etkinleştirene kadar kilitlenecek. Web üzerindeki aboneliğiniz etkilenmeyecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专业版功能将被锁定，直到您重新激活。您在网页版的订阅不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 功能在您再次啟用前將會被鎖定。您在網頁上的訂閱不受影響。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 功能將被鎖定，直到您重新啟用。您在網頁上的訂閱不會受到影響。"
          }
        }
      }
    },
