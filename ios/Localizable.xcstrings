    "%@ stopped because the Mac reported critical memory pressure." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ توقف لأن جهاز Mac أبلغ عن ضغط ذاكرة حرج."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stoppede, fordi Mac'en rapporterede kritisk hukommelsespres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde gestoppt, weil der Mac kritischen Speicherdruck gemeldet hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stopped because the Mac reported critical memory pressure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se detuvo porque el Mac informó de una presión de memoria crítica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s'est arrêté car le Mac a signalé une pression mémoire critique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berhenti karena Mac melaporkan tekanan memori kritis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ si è interrotto perché il Mac ha segnalato una pressione di memoria critica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、Macが重大なメモリプレッシャーを報告したため停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) Mac이 심각한 메모리 압박을 보고하여 중단되었습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dihentikan kerana Mac melaporkan tekanan memori kritikal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stoppet fordi Mac-en rapporterte kritisk minnepress."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is gestopt omdat de Mac kritieke geheugenbelasting heeft gemeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ został zatrzymany, ponieważ Mac zgłosił krytyczne obciążenie pamięci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ parou porque o Mac relatou pressão crítica de memória."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stoppades eftersom Mac rapporterade kritisk minnespåfrestning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ durdu çünkü Mac kritik bellek baskısı bildirdi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已停止，因为 Mac 报告了严重的内存压力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已停止，因為 Mac 回報了嚴重的記憶體壓力。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已停止，因為 Mac 回報了嚴重的記憶體壓力。"
          }
        }
      }
