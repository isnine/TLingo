    "TLingo can use AI models to translate languages, keep your meaning, and polish sentences to sound natural." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ TLingo استخدام نماذج الذكاء الاصطناعي لترجمة اللغات، والحفاظ على المعنى، وصقل الجمل لتبدو طبيعية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo kan bruge AI-modeller til at oversætte sprog, bevare din betydning og polere sætninger, så de lyder naturlige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo kann KI‑Modelle nutzen, um Sprachen zu übersetzen, Ihre Bedeutung zu bewahren und Sätze zu verfeinern, damit sie natürlich klingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo can use AI models to translate languages, keep your meaning, and polish sentences to sound natural."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo puede usar modelos de IA para traducir idiomas, conservar tu significado y pulir las oraciones para que suenen naturales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo peut utiliser des modèles d'IA pour traduire des langues, préserver votre sens et peaufiner les phrases pour qu'elles paraissent naturelles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo dapat menggunakan model AI untuk menerjemahkan bahasa, menjaga makna Anda, dan memperhalus kalimat agar terdengar alami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo può utilizzare modelli di IA per tradurre lingue, mantenere il tuo significato e perfezionare le frasi per suonare naturali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo は AI モデルを利用して言語を翻訳し、意味を保ち、文を自然に聞こえるように整えることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo는 AI 모델을 사용하여 언어를 번역하고, 의미를 유지하며, 문장을 더 자연스럽게 다듬을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo boleh menggunakan model AI untuk menterjemah bahasa, mengekalkan maksud anda, dan memperhalusi ayat supaya kedengaran semula jadi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo kan bruke AI-modeller til å oversette språk, bevare meningen din og polere setninger slik at de høres naturlige ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo kan AI-modellen gebruiken om talen te vertalen, je betekenis te behouden en zinnen te verfijnen zodat ze natuurlijk klinken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo może używać modeli sztucznej inteligencji do tłumaczenia języków, zachowania sensu i dopracowania zdań, aby brzmiały naturalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O TLingo pode usar modelos de IA para traduzir idiomas, manter seu significado e polir frases para que soem naturais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo kan använda AI-modeller för att översätta språk, behålla din betydelse och polera meningar så att de låter naturliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo, dilleri çevirmek, anlamınızı korumak ve cümleleri doğal olacak şekilde düzeltmek için yapay zeka modelleri kullanabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo 可以使用 AI 模型帮你翻译语言、保留原意，并把句子打磨得更自然。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo 可以使用 AI 模型幫你翻譯語言、保留原意，並把句子打磨得更自然。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo 可以使用 AI 模型幫你翻譯語言、保留原意，並將句子打磨得更自然。"
          }
        }
      }
    },
    "TLingo could not confirm Microphone access. Check Settings before starting realtime captions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo تعذر عليه تأكيد الوصول إلى الميكروفون. تحقق من الإعدادات قبل بدء التسميات التوضيحية في الوقت الفعلي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo kunne ikke bekræfte mikrofontilgang. Tjek Indstillinger, før du starter undertekster i realtid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo konnte den Mikrofonzugriff nicht bestätigen. Überprüfen Sie die Einstellungen, bevor Sie Echtzeit-Untertitel starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TLingo could not confirm Microphone access. Check Settings before starting realtime captions."
          }
