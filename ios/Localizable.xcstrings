    "Apple Translate has not downloaded this language pair. Use Apple Translate in the main app once, then start iPhone Audio again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم تنزيل هذا الزوج اللغوي في Apple Translate. استخدم Apple Translate في التطبيق الرئيسي مرة واحدة، ثم أعد تشغيل صوت iPhone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate har ikke hentet dette sprogpar. Brug Apple Translate i hovedappen én gang, og start derefter iPhone-lyd igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate hat dieses Sprachpaar nicht heruntergeladen. Verwenden Sie Apple Translate einmal in der Haupt-App und starten Sie dann iPhone-Audio erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apple Translate has not downloaded this language pair. Use Apple Translate in the main app once, then start iPhone Audio again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate no ha descargado este par de idiomas. Use Apple Translate en la aplicación principal una vez y luego inicie el audio del iPhone de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate n'a pas téléchargé cette paire de langues. Utilisez Apple Translate dans l'application principale une fois, puis relancez l'audio de l'iPhone."
