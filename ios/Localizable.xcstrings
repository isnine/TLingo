    "Microphone capture stopped unexpectedly. %@ End Realtime and start realtime again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقفت عملية التقاط الميكروفون بشكل غير متوقع. %@ أنهِ Realtime وابدأ realtime مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonoptagelse stoppede uventet. %@ Afslut Realtime og start realtime igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonaufzeichnung wurde unerwartet gestoppt. %@ Beende Realtime und starte realtime erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone capture stopped unexpectedly. %@ End Realtime and start realtime again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura del micrófono se detuvo inesperadamente. %@ Finaliza Realtime y vuelve a iniciar realtime."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture du microphone s'est arrêtée de manière inattendue. %@ Terminez Realtime et relancez realtime."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengambilan mikrofon berhenti secara tiba-tiba. %@ Akhiri Realtime dan mulai ulang realtime."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cattura del microfono si è interrotta inaspettatamente. %@ Termina Realtime e avvia nuovamente realtime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクのキャプチャが予期せず停止しました。%@ Realtimeを終了して、再度realtimeを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 캡처가 예기치 않게 중지되었습니다. %@ Realtime를 종료하고 realtime을 다시 시작하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakaman mikrofon dihentikan secara tidak dijangka. %@ Akhiri Realtime dan mulakan semula realtime."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonopptak stoppet uventet. %@ Avslutt Realtime og start realtime på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microfoonopname is onverwacht gestopt. %@ Sluit Realtime af en start realtime opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechwytywanie mikrofonu zostało niespodziewanie zatrzymane. %@ Zakończ Realtime i uruchom realtime ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A captura do microfone foi interrompida inesperadamente. %@ Encerre o Realtime e inicie o realtime novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofoninspelning stoppade oväntat. %@ Avsluta Realtime och starta realtime igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon yakalaması beklenmedik şekilde durdu. %@ Realtime'i sonlandırın ve realtime'i yeniden başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风采集意外停止。%@ 结束 Realtime，然后重新启动 realtime。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取麥克風時出現非預期停止。%@ 結束 Realtime，然後再次啟動 realtime。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取麥克風時出現非預期停止。%@ 結束 Realtime，然後再次啟動 realtime。"
          }
        }
      }
