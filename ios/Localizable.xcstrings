    "Already listed? Remove the old entry with −, then drag TLingo in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مُدرج بالفعل؟ أزل الإدخال القديم باستخدام −، ثم اسحب TLingo مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allerede opført? Fjern den gamle post med −, og træk derefter TLingo ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon aufgeführt? Entfernen Sie den alten Eintrag mit −, und ziehen Sie TLingo dann erneut hinein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already listed? Remove the old entry with −, then drag TLingo in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya está en la lista? Elimina la entrada antigua con −, luego arrastra TLingo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà listé ? Supprimez l'ancienne entrée avec −, puis faites glisser TLingo à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah tercantum? Hapus entri lama dengan −, lalu seret TLingo lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già elencato? Rimuovi la voce precedente con −, quindi trascina nuovamente TLingo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに一覧にありますか？古い項目を−で削除してから、TLingoをもう一度ドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 목록에 있나요? 오래된 항목을 −로 제거한 다음 TLingo를 다시 드래그하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah disenaraikan? Alih keluar entri lama dengan −, kemudian seret TLingo masuk semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allerede oppført? Fjern den gamle oppføringen med −, og dra deretter TLingo inn igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al opgenomen? Verwijder de oude invoer met − en sleep vervolgens TLingo opnieuw naar binnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Już na liście? Usuń stary wpis za pomocą −, a następnie przeciągnij TLingo ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já listado? Remova a entrada antiga com −, então arraste o TLingo novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redan listad? Ta bort den gamla posten med −, och dra sedan in TLingo igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten listede mi? Eski girdiyi − ile kaldırın, sonra TLingo'yu tekrar sürükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已列出？使用 − 删除旧条目，然后再次将 TLingo 拖入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已列出嗎？用 − 移除舊項目，然後再把 TLingo 拖入。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已列出嗎？用 − 移除舊項目，然後再把 TLingo 拖入。"
          }
        }
      }
    },
