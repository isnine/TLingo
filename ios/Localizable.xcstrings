    "Realtime supports up to three lanes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم الوضع في الوقت الحقيقي ما يصل إلى ثلاث مسارات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtid understøtter op til tre spor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echtzeit unterstützt bis zu drei Spuren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime supports up to three lanes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La función en tiempo real admite hasta tres carriles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode en temps réel prend en charge jusqu'à trois voies."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu nyata mendukung hingga tiga jalur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità in tempo reale supporta fino a tre corsie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムでは最大3つのレーンをサポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간은 최대 3개의 레인을 지원합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan masa nyata menyokong sehingga tiga saluran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanntid støtter opptil tre spor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime ondersteunt maximaal drie sporen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tłumaczenie w czasie rzeczywistym obsługuje do trzech ścieżek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo em tempo real suporta até três faixas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtid stöder upp till tre spår."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı en fazla üç hattı destekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时支持最多三个通道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時支援最多三條通道。"
