    "Two views use the same recognition and translation models. Change a model or remove the duplicate view." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرضان يستخدمان نفس نماذج التعرف والترجمة. غيّر نموذجًا أو أزل العرض المكرر."
