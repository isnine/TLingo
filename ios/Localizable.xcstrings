    "Realtime captions need audio and speech access. TLingo asks macOS once now so it appears in Privacy & Security." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب التسميات التوضيحية في الوقت الحقيقي الوصول إلى الصوت والكلام. يقوم TLingo بطلب ذلك من macOS مرة واحدة الآن حتى يظهر في Privacy & Security."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtidsundertekster kræver adgang til lyd og tale. TLingo beder macOS én gang nu, så det vises i Privacy & Security."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echtzeituntertitel benötigen Zugriff auf Audio und Sprache. TLingo fragt macOS jetzt einmal, damit es in Privacy & Security angezeigt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime captions need audio and speech access. TLingo asks macOS once now so it appears in Privacy & Security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos en tiempo real necesitan acceso al audio y al habla. TLingo solicita a macOS ese permiso una vez para que aparezca en Privacy & Security."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres en temps réel nécessitent l'accès à l'audio et à la parole. TLingo demande cet accès à macOS une seule fois afin d'apparaître dans Privacy & Security."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks waktu nyata memerlukan akses audio dan suara. TLingo sekarang meminta macOS sekali agar muncul di Privacy & Security."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli in tempo reale necessitano dell'accesso ad audio e voce. TLingo richiede a macOS l'autorizzazione una sola volta, così che appaia in Privacy & Security."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム字幕にはオーディオと音声のアクセスが必要です。TLingo は macOS に一度だけ要求するので、Privacy & Security に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 자막은 오디오 및 음성 접근이 필요합니다. TLingo는 macOS에 한 번 요청하므로 Privacy & Security에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks langsung memerlukan akses audio dan pengenalan pertuturan. TLingo akan meminta akses daripada macOS sekali, supaya ia muncul di Privasi & Keselamatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanntidsundertekster trenger tilgang til lyd og tale. TLingo ber macOS om dette nå, slik at det vises i Personvern og sikkerhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime-ondertitels hebben toegang tot audio en spraak nodig. TLingo vraagt macOS nu één keer, zodat het in Privacy & Security verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisy na żywo potrzebują dostępu do dźwięku i rozpoznawania mowy. TLingo poprosi macOS o dostęp tylko raz — dzięki temu pojawi się on w sekcji Prywatność i bezpieczeństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas em tempo real precisam de acesso a áudio e fala. TLingo solicita ao macOS uma vez agora para que apareça em Privacy & Security."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtidsundertexter behöver åtkomst till ljud och tal. TLingo ber macOS en gång nu så att det visas i Privacy & Security."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı altyazılar için ses ve konuşma erişimi gerekir. TLingo, macOS'tan bir kez ister, böylece Privacy & Security'de görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时字幕需要音频和语音访问。TLingo 现在会向 macOS 请求一次，以便它出现在 Privacy & Security。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時字幕需要存取音訊及語音。TLingo 現在會向 macOS 請求一次，以便顯示在「隱私與安全性」中。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時字幕需要音訊和語音存取。TLingo 現在會向 macOS 請求一次，讓它出現在 Privacy & Security。"
          }
        }
      }
    },
