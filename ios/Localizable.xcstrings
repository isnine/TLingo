          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン用のリンクの有効期限が切れています。やり直すには「再試行」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 링크의 유효기간이 만료되었습니다. 다시 시작하려면 '다시 시도'를 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pautan log masuk tamat tempoh. Ketik 'Cuba lagi' untuk mula semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påloggingslenken er utløpt. Trykk på 'Prøv igjen' for å starte på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanmeldingslink is verlopen. Tik op 'Probeer opnieuw' om opnieuw te beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link do logowania wygasł. Stuknij 'Spróbuj ponownie', aby zacząć od nowa."
          }
        },
        "pt-BR" : {
