    "Describe what you want the action to do — the more detail, the better." : {
      "comment" : "Voice recording guidance",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صف ما تريد أن تفعله الإجراء - كلما كان ذلك أكثر تفصيلاً، كان ذلك أفضل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv, hvad du ønsker, at handlingen skal gøre — jo mere detaljeret, jo bedre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreiben Sie, was Sie möchten, dass die Aktion tut – je detaillierter, desto besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe what you want the action to do — the more detail, the better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe lo que quieres que haga la acción: cuanto más detalle, mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez ce que vous voulez que l'action fasse — plus vous donnez de détails, mieux c'est."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelaskan apa yang Anda inginkan dari tindakan tersebut — semakin banyak detail, semakin baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi cosa vuoi che l'azione faccia — più dettagli, meglio è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクションに何をしてほしいかを説明してください — 詳細が多いほど良いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신이 원하는 행동이 무엇인지 설명하십시오 — 세부 사항이 많을수록 좋습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terangkan apa yang anda mahu tindakan itu lakukan — semakin banyak butiran, semakin baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv hva du vil at handlingen skal gjøre - jo mer detaljert, jo bedre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
