    "Enable Microphone access in Settings before starting realtime captions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتمكين الوصول إلى الميكروفون في الإعدادات قبل بدء التسميات التوضيحية في الوقت الفعلي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér mikrofonadgang i Indstillinger, før du starter undertekster i realtid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie den Mikrofonzugriff in den Einstellungen, bevor Sie Echtzeit-Untertitel starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable Microphone access in Settings before starting realtime captions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilite el acceso al micrófono en Ajustes antes de iniciar los subtítulos en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès au microphone dans Réglages avant de démarrer les sous-titres en temps réel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan akses mikrofon di Pengaturan sebelum memulai teks waktu nyata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l'accesso al microfono in Impostazioni prima di avviare i sottotitoli in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム字幕を開始する前に、設定でマイクへのアクセスを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 자막을 시작하기 전에 설정에서 마이크 접근을 활성화하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan akses mikrofon di Tetapan sebelum memulakan sari kata masa nyata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver mikrofontilgang i Innstillinger før du starter sanntidsundertekster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel microfoontoegang in Instellingen in, voordat je realtime ondertitels start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz dostęp do mikrofonu w Ustawieniach przed rozpoczęciem napisów na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso ao microfone em Ajustes antes de iniciar as legendas em tempo real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera mikrofonåtkomst i Inställningar innan du börjar med undertexter i realtid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı altyazıları başlatmadan önce Ayarlar'da Mikrofon erişimini etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在开始实时字幕之前，请在“设置”中启用麦克风访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在開始即時字幕之前，請在「設定」中啟用麥克風存取權限。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在開始即時字幕之前，請在「設定」中啟用麥克風存取權。"
          }
        }
      }
    },
