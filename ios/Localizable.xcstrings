    "Speech recognition access is required for realtime subtitles." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الوصول إلى التعرف على الكلام لعرض ترجمات في الوقت الحقيقي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til talegenkendelse er påkrævet for undertekster i realtid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf die Spracherkennung ist für Echtzeit-Untertitel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition access is required for realtime subtitles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso al reconocimiento de voz para subtítulos en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la reconnaissance vocale est nécessaire pour les sous-titres en temps réel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses pengenalan suara diperlukan untuk subtitle waktu nyata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso al riconoscimento vocale è necessario per i sottotitoli in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム字幕には音声認識へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 자막을 사용하려면 음성 인식 접근 권한이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses pengenalan suara diperlukan untuk sari kata masa nyata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til talegjenkjenning kreves for sanntidsundertekster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot spraakherkenning is vereist voor realtime-ondertiteling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do rozpoznawania mowy jest wymagany do napisów na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao reconhecimento de fala é necessário para legendas em tempo real."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till taligenkänning krävs för undertexter i realtid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
