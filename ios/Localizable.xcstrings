    "e.g. \"Translate to formal Japanese and show side-by-side comparison\"" : {
      "comment" : "Voice recording example",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثل: \"ترجمة إلى اليابانية الرسمية وعرض مقارنة جنبًا إلى جنب\""
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f.eks.: \"Oversæt til formelt japansk og vis sammenligning side om side\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z.B. \"In formelles Japanisch übersetzen und einen Seitenvergleich anzeigen\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. \"Translate to formal Japanese and show side-by-side comparison\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p.ej. \"Traducir al japonés formal y mostrar comparación lado a lado\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ex : \"Traduire en japonais formel et montrer une comparaison côte à côte\""
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "misalnya: \"Terjemahkan ke bahasa Jepang formal dan tunjukkan perbandingan berdampingan\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "es. \"Traduci in giapponese formale e mostra un confronto affiancato\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例: \"形式的な日本語に翻訳し、横に比較を表示する\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예: \"공식 일본어로 번역하고 나란히 비교 보기\""
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cth. \"Terjemahkan ke bahasa Jepun formal dan tunjukkan perbandingan sebelah-menyebelah\""
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f.eks. \"Oversett til formelt japansk og vis sammenligning side om side\""
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bijv. \"Vertaal naar formeel Japans en toon een zij-aan-zij vergelijking\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "np. \"Przetłumacz na japoński formalny i pokaż porównanie obok siebie\""
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p. ex. \"Traduzir para o japonês formal e mostrar comparação lado a lado\""
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "t.ex. \"Översätt till formellt japanska och visa jämförelse sida vid sida\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "örn. \"Resmi Japoncaya çevir ve yan yana karşılaştırmayı göster\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：\"翻译成正式的日语并显示并排比较\""
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：\"翻譯成正式的日文並顯示並排比較\""
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：\"翻譯成正式的日語並顯示並排比較\""
          }
        }
      }
    },
