    "If TLingo is already listed, remove the old entry with −, then drag this TLingo in again." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان TLingo مدرجًا بالفعل، فأزل الإدخال القديم باستخدام −، ثم اسحب TLingo الحالي إلى القائمة مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis TLingo allerede står på listen, skal du fjerne den gamle post med − og derefter trække denne TLingo ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn TLingo bereits aufgeführt ist, entferne den alten Eintrag mit − und ziehe dieses TLingo anschließend erneut hinein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If TLingo is already listed, remove the old entry with −, then drag this TLingo in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si TLingo ya aparece en la lista, elimina la entrada anterior con − y vuelve a arrastrar este TLingo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si TLingo figure déjà dans la liste, supprimez l’ancienne entrée avec −, puis faites-y glisser ce TLingo à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika TLingo sudah tercantum, hapus entri lama dengan −, lalu seret TLingo ini masuk lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se TLingo è già presente nell’elenco, rimuovi la vecchia voce con −, quindi trascina di nuovo questo TLingo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo がすでに一覧にある場合は、− で古い項目を削除してから、この TLingo をもう一度ドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에 TLingo가 이미 있다면 − 버튼으로 이전 항목을 제거한 다음 현재 TLingo를 다시 드래그하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika TLingo sudah tersenarai, keluarkan entri lama dengan −, kemudian seret TLingo ini masuk semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis TLingo allerede står i listen, fjerner du den gamle oppføringen med − og drar deretter denne TLingo inn på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als TLingo al in de lijst staat, verwijder je de oude vermelding met − en sleep je deze TLingo opnieuw naar de lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli TLingo jest już na liście, usuń stary wpis przyciskiem −, a następnie przeciągnij bieżącą aplikację TLingo ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o TLingo já estiver na lista, remova a entrada antiga com − e arraste este TLingo novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om TLingo redan finns i listan tar du bort den gamla posten med − och drar sedan in denna TLingo igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLingo zaten listeleniyorsa eski girişi − ile kaldırın, ardından bu TLingo'yu tekrar sürükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果列表中已有 TLingo，请先用“−”移除旧项目，然后重新拖入当前 TLingo。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果列表中已有 TLingo，請先用「−」移除舊項目，然後重新拖入目前的 TLingo。"
          }
