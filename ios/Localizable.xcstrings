    "We'll remind you before your trial ends, so you can cancel in time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنذكرك قبل انتهاء الفترة التجريبية حتى تتمكن من الإلغاء في الوقت المناسب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi minder dig om det, før din prøveperiode slutter, så du kan opsige i tide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erinnern Sie, bevor Ihre Testphase endet, damit Sie rechtzeitig kündigen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll remind you before your trial ends, so you can cancel in time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te recordaremos antes de que termine tu prueba, para que puedas cancelar a tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous rappellerons avant la fin de votre essai afin que vous puissiez annuler à temps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan mengingatkan Anda sebelum masa percobaan Anda berakhir, sehingga Anda bisa membatalkan tepat waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ricorderemo prima della fine della prova, così potrai annullare in tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トライアル終了前にお知らせしますので、期限内にキャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험 기간이 끝나기 전에 알려드려 제때 취소하실 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan mengingatkan anda sebelum tempoh percubaan anda tamat, supaya anda boleh membatalkan tepat pada masanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi minner deg før prøveperioden avsluttes, slik at du kan si den opp i tide."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We herinneren je voordat je proefperiode eindigt, zodat je op tijd kunt annuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnimy Ci przed zakończeniem okresu próbnego, abyś mógł anulować na czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nós vamos lembrá‑lo antes do fim do seu teste, para que você possa cancelar a tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi påminner dig innan din provperiod avslutas, så att du kan säga upp i tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme süreniz bitmeden önce sizi hatırlatacağız, böylece zamanında iptal edebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在试用期结束前，我们会提醒您，以便您能及时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在試用期結束前，我們會提醒您，以便您能及時取消。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用期結束前我們會提醒你，讓你可以及時取消。"
          }
        }
      }
    },
