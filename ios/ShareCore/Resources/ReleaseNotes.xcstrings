          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade till ett uppspelningsbart exempel i iPhone Audio-onboarding och gjorde appens språk till standard för Realtime-konfigurationen."
          }
