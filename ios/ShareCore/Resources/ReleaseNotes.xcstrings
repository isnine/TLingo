          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 잠금 및 중단이 발생해도 마이크와 iPhone 오디오 세션을 유지하고, iOS가 허용할 때 재개하도록 했습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekalkan sesi mikrofon dan Audio iPhone melalui kunci skrin dan gangguan, serta menyambung semula apabila iOS membenarkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholdt mikrofon- og iPhone Audio-økter gjennom skjermlås og avbrudd, og gjenopptok når iOS tillater det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microfoon- en iPhone Audio-sessies bleven behouden tijdens schermvergrendeling en onderbrekingen, en worden hervat wanneer iOS dit toestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymano sesje mikrofonu i dźwięku iPhone podczas blokady ekranu i przerw, wznawiając je, gdy iOS na to pozwala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantivemos as sessões de microfone e Áudio do iPhone durante o bloqueio de tela e interrupções, retomando quando o iOS permite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behöll mikrofon- och iPhone Audio-sessioner genom skärmlås och avbrott och återupptog när iOS tillåter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran kilidi ve kesintiler boyunca mikrofon ve iPhone Ses oturumları korundu ve iOS izin verdiğinde devam ettirildi."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在螢幕鎖定與中斷期間保留麥克風與 iPhone 音訊工作階段，並在 iOS 允許時繼續。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在屏幕锁定和中断期间保留麦克风和 iPhone 音频会话，并在 iOS 允许时恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在螢幕鎖定與中斷期間保留麥克風與 iPhone 音訊工作階段，並在 iOS 允許時恢復。"
          }
        }
      }
    },
    "Kept realtime running in the background, synced Picture in Picture pause state, and improved long-session performance." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقينا الترجمة الفورية تعمل في الخلفية، وزامنّا حالة الإيقاف المؤقت في الصورة داخل الصورة، وحسّنّا أداء الجلسات الطويلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holdt realtid kørende i baggrunden, synkroniserede pausestatus for Picture in Picture og forbedrede ydeevnen ved lange sessioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echtzeit im Hintergrund weiterlaufen lassen, Pausenstatus von Bild-in-Bild synchronisiert und Leistung bei langen Sitzungen verbessert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept realtime running in the background, synced Picture in Picture pause state, and improved long-session performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantuvimos el tiempo real en segundo plano, sincronizamos el estado de pausa de Imagen en imagen y mejoramos el rendimiento en sesiones largas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintien du temps réel en arrière-plan, synchronisation de l’état de pause de Picture in Picture et amélioration des performances sur les longues sessions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjaga realtime tetap berjalan di latar belakang, menyinkronkan status jeda Picture in Picture, dan meningkatkan performa sesi panjang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenuto il tempo reale in esecuzione in background, sincronizzato lo stato di pausa di Picture in Picture e migliorato le prestazioni nelle sessioni lunghe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムをバックグラウンドで実行し続け、ピクチャ・イン・ピクチャの一時停止状態を同期し、長時間セッションのパフォーマンスを改善しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 기능이 백그라운드에서 계속 실행되도록 하고, PIP 일시 정지 상태를 동기화했으며, 장시간 세션 성능을 개선했습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekalkan masa nyata berjalan di latar belakang, menyegerakkan keadaan jeda Picture in Picture dan meningkatkan prestasi sesi panjang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holdt sanntid kjørende i bakgrunnen, synkroniserte pausestatus for bilde-i-bilde og forbedret ytelsen ved lange økter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtime op de achtergrond laten doorlopen, pauzestatus van Picture in Picture gesynchroniseerd en prestaties bij lange sessies verbeterd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymano działanie czasu rzeczywistego w tle, zsynchronizowano stan wstrzymania Obraz w obrazie i poprawiono wydajność długich sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantivemos o tempo real em execução em segundo plano, sincronizamos o estado de pausa do Picture in Picture e melhoramos o desempenho em sessões longas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höll realtid igång i bakgrunden, synkroniserade pausläget för bild-i-bild och förbättrade prestandan vid långa sessioner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı özelliği arka planda çalışır durumda tuttu, Resim içinde Resim duraklatma durumunu eşitledi ve uzun oturum performansını iyileştirdi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让实时功能在后台继续运行，同步画中画暂停状态，并提升长时间会话的性能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓即時功能在背景繼續執行，同步子母畫面暫停狀態，並提升長時間工作階段的效能。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓即時功能在背景繼續運行，同步畫中畫暫停狀態，並提升長時間工作階段的效能。"
          }
        }
      }
    },
    "Made realtime input and speech recognition options easier to find, and enabled transcription-only mode for iPhone audio." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جعلنا خيارات الإدخال الفوري والتعرف على الكلام أسهل في العثور عليها، وفعّلنا وضع النسخ فقط لصوت iPhone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjort indstillinger for realtidsinput og talegenkendelse lettere at finde og aktiveret en tilstand kun til transskription for iPhone-lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Optionen für Echtzeiteingabe und Spracherkennung leichter auffindbar gemacht und einen Nur-Transkriptionsmodus für iPhone-Audio aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made realtime input and speech recognition options easier to find, and enabled transcription-only mode for iPhone audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han hecho más fáciles de encontrar las opciones de entrada en tiempo real y reconocimiento de voz, y se ha activado el modo solo transcripción para el audio del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les options de saisie en temps réel et de reconnaissance vocale sont plus faciles à trouver, et un mode transcription seule pour l’audio de l’iPhone a été activé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat opsi input real-time dan pengenalan suara lebih mudah ditemukan, serta mengaktifkan mode hanya transkripsi untuk audio iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rese più facili da trovare le opzioni di input in tempo reale e riconoscimento vocale, e attivata la modalità solo trascrizione per l’audio di iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム入力と音声認識のオプションを見つけやすくし、iPhoneのオーディオ向けに文字起こしのみのモードを有効にしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 입력 및 음성 인식 옵션을 더 쉽게 찾을 수 있도록 했으며, iPhone 오디오에 대해 전사 전용 모드를 활성화했습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjadikan pilihan input masa nyata dan pengecaman pertuturan lebih mudah ditemui, dan mendayakan mod transkripsi sahaja untuk audio iPhone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjort alternativer for sanntidsinndata og talegjenkjenning lettere å finne, og aktivert en modus kun for transkripsjon for iPhone-lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opties voor realtime-invoer en spraakherkenning zijn makkelijker te vinden, en een modus voor alleen transcriptie voor iPhone-audio is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułatwiono znajdowanie opcji wprowadzania w czasie rzeczywistym i rozpoznawania mowy oraz włączono tryb tylko transkrypcji dla dźwięku z iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As opções de entrada em tempo real e reconhecimento de fala ficaram mais fáceis de encontrar, e o modo somente transcrição para áudio do iPhone foi ativado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjort alternativen för realtidsinmatning och taligenkänning lättare att hitta samt aktiverat ett läge endast för transkribering för iPhone-ljud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı giriş ve konuşma tanıma seçeneklerini bulmayı kolaylaştırdık ve iPhone sesi için yalnızca transkripsiyon modunu etkinleştirdik."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "令實時輸入同語音辨識選項更容易搵到，並為 iPhone 音訊啟用咗只限轉錄模式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让实时输入和语音识别选项更容易找到，并为 iPhone 音频启用了仅转写模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓即時輸入和語音辨識選項更容易找到，並為 iPhone 音訊啟用了僅轉寫模式。"
          }
        }
      }
    },
    "Moved model reordering into the model picker sheet, with its own reset and done actions." : {
      "extractionState" : "manual",
