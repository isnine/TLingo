    "New installs start with Microsoft Translate and the first free AI model enabled, and results default to model list order." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ عمليات التثبيت الجديدة مع تمكين Microsoft Translate وأول نموذج ذكاء اصطناعي مجاني، وتكون النتائج افتراضيًا حسب ترتيب قائمة النماذج."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye installationer starter med Microsoft Translate og den første gratis AI-model aktiveret, og resultater følger som standard modellistens rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Installationen starten mit aktiviertem Microsoft Translate und dem ersten kostenlosen KI-Modell; Ergebnisse folgen standardmäßig der Reihenfolge der Modellliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
