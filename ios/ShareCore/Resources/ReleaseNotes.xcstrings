    "Preserved IME composition and translation input, surfaced manual OAuth refresh failures, and kept vocabulary changes consistent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظنا على تكوين IME وإدخال الترجمة، وأظهرنا إخفاقات تحديث OAuth اليدوي، وأبقينا تغييرات المفردات متسقة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarede IME-sammensætning og oversættelsesinput, synliggjorde manuelle OAuth-opdateringsfejl og holdt ordforrådsændringer konsistente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IME-Komposition und Übersetzungseingabe beibehalten, manuelle OAuth-Aktualisierungsfehler sichtbar gemacht und Vokabularänderungen konsistent gehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserved IME composition and translation input, surfaced manual OAuth refresh failures, and kept vocabulary changes consistent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservaron la composición del IME y la entrada de traducción, se mostraron los fallos de actualización manual de OAuth y se mantuvieron coherentes los cambios de vocabulario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préservation de la composition IME et de la saisie de traduction, affichage des échecs d’actualisation manuelle OAuth et cohérence des modifications du vocabulaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempertahankan komposisi IME dan input terjemahan, menampilkan kegagalan penyegaran OAuth manual, dan menjaga perubahan kosakata tetap konsisten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenute la composizione IME e l’input di traduzione, resi visibili gli errori di aggiornamento manuale OAuth e mantenute coerenti le modifiche al vocabolario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IME の変換入力と翻訳入力を保持し、手動 OAuth 更新の失敗を表示し、語彙の変更を一貫して保持しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IME 조합 및 번역 입력을 유지하고, 수동 OAuth 새로 고침 실패를 표시하며, 어휘 변경 사항을 일관되게 유지했습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekalkan komposisi IME dan input terjemahan, mendedahkan kegagalan muat semula OAuth manual, dan mengekalkan perubahan perbendaharaan kata secara konsisten."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarte IME-sammensetting og oversettelsesinndata, synliggjorde manuelle OAuth-oppdateringsfeil og holdt ordforrådsendringer konsistente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IME-samenstelling en vertaalinvoer behouden, handmatige OAuth-vernieuwingsfouten zichtbaar gemaakt en wijzigingen in woordenschat consistent gehouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowano kompozycję IME i wprowadzanie tłumaczenia, ujawniono błędy ręcznego odświeżania OAuth i utrzymano spójność zmian słownictwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantivemos a composição do IME e a entrada de tradução, expusemos falhas de atualização manual do OAuth e mantivemos as alterações de vocabulário consistentes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarde IME-sammansättning och översättningsinmatning, synliggjorde manuella OAuth-uppdateringsfel och höll ordförrådsändringar konsekventa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IME birleştirmesini ve çeviri girişini korudu, manuel OAuth yenileme hatalarını gösterdi ve kelime dağarcığı değişikliklerini tutarlı tuttu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留输入法组合和翻译输入，显示手动 OAuth 刷新失败，并保持词汇更改一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留輸入法組合和翻譯輸入，顯示手動 OAuth 重新整理失敗，並保持詞彙變更一致。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
