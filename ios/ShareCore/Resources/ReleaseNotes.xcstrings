        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunto un esempio riproducibile all’onboarding di iPhone Audio e impostata la lingua dell’app come predefinita per la configurazione Realtime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone Audio のオンボーディングに再生可能なサンプルを追加し、Realtime の設定をデフォルトでアプリの言語にしました。"
