{
  "sourceLanguage" : "en",
  "strings" : {
    "Added a centered Quick Panel on macOS with a configurable shortcut, inline actions, and results that hand off to the main window." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضفنا لوحة سريعة مركزية على macOS مع اختصار قابل للتخصيص وإجراءات مضمنة ونتائج تنتقل إلى النافذة الرئيسية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjet et centreret Quick Panel på macOS med en tilpasselig genvej, inline-handlinger og resultater, der overføres til hovedvinduet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein zentriertes Quick Panel auf macOS mit konfigurierbarem Kurzbefehl, Inline-Aktionen und Ergebnissen, die an das Hauptfenster übergeben werden, wurde hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added a centered Quick Panel on macOS with a configurable shortcut, inline actions, and results that hand off to the main window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añadió un Quick Panel centrado en macOS con un atajo configurable, acciones integradas y resultados que se transfieren a la ventana principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajout d’un Quick Panel centré sur macOS avec un raccourci configurable, des actions intégrées et des résultats transmis à la fenêtre principale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan Quick Panel terpusat di macOS dengan pintasan yang dapat dikonfigurasi, tindakan inline, dan hasil yang diteruskan ke jendela utama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunto un Quick Panel centrato su macOS con scorciatoia configurabile, azioni inline e risultati trasferiti alla finestra principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS に中央配置の Quick Panel を追加しました。ショートカットを設定でき、インラインアクションと、メインウインドウに引き継がれる結果を備えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에 중앙 배치된 Quick Panel을 추가했습니다. 구성 가능한 단축키, 인라인 작업, 메인 창으로 전달되는 결과를 지원합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambah Quick Panel berpusat pada macOS dengan pintasan boleh dikonfigurasikan, tindakan sebaris dan hasil yang diserahkan kepada tetingkap utama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La til et sentrert Quick Panel på macOS med en konfigurerbar snarvei, innebygde handlinger og resultater som overføres til hovedvinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gecentreerd Quick Panel op macOS toegevoegd met een configureerbare sneltoets, inline-acties en resultaten die worden doorgegeven aan het hoofdvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodano wyśrodkowany Quick Panel w macOS z konfigurowalnym skrótem, akcjami wbudowanymi i wynikami przekazywanymi do okna głównego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionado um Quick Panel centralizado no macOS com atalho configurável, ações integradas e resultados encaminhados para a janela principal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade till en centrerad Quick Panel på macOS med en konfigurerbar genväg, inline-åtgärder och resultat som överförs till huvudfönstret."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS’te yapılandırılabilir kısayol, satır içi eylemler ve ana pencereye aktarılan sonuçlarla ortalanmış bir Quick Panel eklendi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 上新增居中的 Quick Panel，支持可配置快捷键、内联操作，结果可移交到主窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 上新增置中的 Quick Panel，支援可設定快速鍵、內嵌操作，結果可交接至主視窗。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 上新增置中的 Quick Panel，支援可設定快速鍵、內嵌操作，結果可交接至主視窗。"
          }
        }
      }
    },
    "Added a playable sample to iPhone Audio onboarding and defaulted Realtime setup to the app language." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضفنا نموذجًا قابلًا للتشغيل إلى إعداد iPhone Audio الأولي، وجعلنا إعداد Realtime الافتراضي يستخدم لغة التطبيق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjet en afspillelig prøve til iPhone Audio-onboarding og gjort Realtime-opsætningen til appens sprog som standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein abspielbares Beispiel zum iPhone-Audio-Onboarding hinzugefügt und die Realtime-Einrichtung standardmäßig auf die App-Sprache gesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added a playable sample to iPhone Audio onboarding and defaulted Realtime setup to the app language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añadió una muestra reproducible al onboarding de iPhone Audio y se estableció el idioma de la app como predeterminado para la configuración de Realtime."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajout d’un exemple jouable à l’intégration d’iPhone Audio et configuration Realtime par défaut sur la langue de l’app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan sampel yang dapat diputar ke onboarding iPhone Audio dan menjadikan bahasa aplikasi sebagai default untuk penyiapan Realtime."
