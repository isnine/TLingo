    "Added adjustable caption font, text size, and line spacing for Realtime and Picture in Picture." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضفنا إعدادات قابلة للتعديل لخط التعليقات التوضيحية وحجم النص وتباعد الأسطر في Realtime وPicture in Picture."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjede justerbar undertekstskrift, tekststørrelse og linjeafstand til Realtime og Picture in Picture."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassbare Untertitel-Schriftart, Textgröße und Zeilenabstand für Realtime und Picture in Picture hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
