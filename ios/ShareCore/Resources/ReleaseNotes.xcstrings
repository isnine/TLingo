        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone Audio 온보딩에 재생 가능한 샘플을 추가하고 Realtime 설정 기본값을 앱 언어로 지정했습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambah sampel boleh dimainkan pada onboarding iPhone Audio dan menetapkan penyediaan Realtime kepada bahasa aplikasi secara lalai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La til en avspillbar prøve i iPhone Audio-onboarding og satte Realtime-oppsettet til appens språk som standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een afspeelbaar voorbeeld toegevoegd aan de iPhone Audio-onboarding en de Realtime-instelling standaard op de app-taal gezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodano odtwarzalną próbkę do samouczka iPhone Audio i ustawiono język aplikacji jako domyślny dla konfiguracji Realtime."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
