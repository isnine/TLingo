          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有按一下懸浮球時才會將文字發送給 TLingo。翻譯、歷史記錄和訂閱都由 TLingo 處理。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
